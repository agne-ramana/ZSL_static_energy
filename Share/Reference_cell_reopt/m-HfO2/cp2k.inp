&GLOBAL
  PROJECT m-HfO2
  RUN_TYPE CELL_OPT
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL

  &DFT
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS

    ! --- 1. CHARGE & MULTIPLICITY ---
    CHARGE 0
    MULTIPLICITY 1

    ! --- 2. K-POINTS ---
    &KPOINTS
      SCHEME MONKHORST-PACK 6 6 6
    &END KPOINTS

    ! --- 3. NOISE SUPPRESSION: Tighter matrix integration ---
    &QS
      EPS_DEFAULT 1.0E-12
      EXTRAPOLATION USE_GUESS
    &END QS

    ! --- 4. NOISE SUPPRESSION: Strict electronic convergence ---
    &SCF
      MAX_SCF 100
      EPS_SCF 1.0E-8
      SCF_GUESS ATOMIC
      ADDED_MOS 12

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 8
      &END MIXING

      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
    &END SCF

    ! --- 5. NOISE SUPPRESSION: Massive grid density ---
    &MGRID
      CUTOFF 1000
      NGRIDS 5
      REL_CUTOFF 80
    &END MGRID

    ! --- 6. EXCHANGE CORRELATION ---
    &XC
      &XC_FUNCTIONAL
        &PBE
          PARAMETRIZATION PBESOL
        &END PBE
      &END XC_FUNCTIONAL
    &END XC

    ! --- 7. POISSON SOLVER ---
    &POISSON
      PERIODIC XYZ
    &END POISSON
  &END DFT

  ! --- 8. STRUCTURE: cell + coords read straight from bulk.cif ---
  &SUBSYS
    &CELL
      CELL_FILE_FORMAT CIF
      CELL_FILE_NAME bulk.cif
    &END CELL

    &TOPOLOGY
      COORD_FILE_FORMAT CIF
      COORD_FILE_NAME bulk.cif
    &END TOPOLOGY

    &KIND Hf
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q12
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL

! --- 9. OPTIMISER SETTINGS ---
&MOTION
  &CELL_OPT
    TYPE DIRECT_CELL_OPT
    MAX_ITER 400
    OPTIMIZER LBFGS
    MAX_DR 0.02
    RMS_FORCE 1.0E-5
    EXTERNAL_PRESSURE [bar] 1.0
    PRESSURE_TOLERANCE [bar] 100.0
    KEEP_SYMMETRY .TRUE.
  &END CELL_OPT

  &PRINT
    &TRAJECTORY
      &EACH
        CELL_OPT 1
      &END EACH
      ADD_LAST NUMERIC
      FORMAT XYZ
    &END TRAJECTORY

    &CELL
      &EACH
        CELL_OPT 1
      &END EACH
      ADD_LAST NUMERIC
    &END CELL
  &END PRINT
&END MOTION
