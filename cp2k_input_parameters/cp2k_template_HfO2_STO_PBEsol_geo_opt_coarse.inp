&GLOBAL
  PROJECT STO_HfO2_Interface
  RUN_TYPE GEO_OPT
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  
  &DFT
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS

    ! --- 1. CHARGE & MULTIPLICITY ---
    CHARGE 0
    MULTIPLICITY 1

    ! --- 2. SCF CONVERGENCE ---
    &SCF
      MAX_SCF 400
      EPS_SCF 1.0E-6
      SCF_GUESS RESTART
      
      IGNORE_CONVERGENCE_FAILURE .TRUE.

      &OT
        MINIMIZER CG
        PRECONDITIONER FULL_SINGLE_INVERSE
        ENERGY_GAP 0.001         
      &END OT
      
      &OUTER_SCF
        MAX_SCF 10
        EPS_SCF 1.0E-6
      &END OUTER_SCF
    &END SCF

    ! --- 3. SYSTEM CELL ---
    &MGRID
      CUTOFF 600
      NGRIDS 5
      REL_CUTOFF 60
    &END MGRID

    ! --- 4. EXCHANGE CORRELATION ---
    &XC
      &XC_FUNCTIONAL
        &PBE
          PARAMETRIZATION PBESOL
        &END PBE
      &END XC_FUNCTIONAL
    &END XC

    ! --- 5. POISSON SOLVER & SURFACE CORRECTION ---
    &POISSON
      POISSON_SOLVER PERIODIC
      PERIODIC XYZ
    &END POISSON

    SURFACE_DIPOLE_CORRECTION .TRUE.
    SURF_DIP_DIR Z

  &END DFT

  ! --- 6. ATOMIC DEFINITIONS ---
  &SUBSYS
    &CELL
      __CELL__  
    &END CELL

    &COORD
      __COORD__
    &END COORD

    &KIND Sr
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q10
    &END KIND

    &KIND Ti
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q12
    &END KIND

    &KIND Hf
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q12
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

! --- 7. OPTIMISER SETTINGS ---
&MOTION
  &GEO_OPT
    TYPE MINIMIZATION
    MAX_ITER  200              
    OPTIMIZER LBFGS
  &END GEO_OPT
  
  &PRINT 
    &TRAJECTORY
      ADD_LAST NUMERIC
      FORMAT XYZ
      &EACH
        GEO_OPT 1
        CELL_OPT 1
      &END EACH
    &END TRAJECTORY  
    &FORCES
      ADD_LAST NUMERIC
      FORMAT XYZ
      &EACH
        GEO_OPT 1
        CELL_OPT 1
      &END EACH      
    &END FORCES  
    &STRESS 
      ADD_LAST NUMERIC
      &EACH
        GEO_OPT 1
        CELL_OPT 1
      &END EACH
    &END STRESS
  &END PRINT  
&END MOTION
